{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaparthy.dev/contracts/v0.1.2/commit-node.schema.json",
  "title": "CommitNode",
  "type": "object",
  "additionalProperties": false,
  "required": ["hash", "parents", "agent_id", "status"],
  "properties": {
    "hash": { "type": "string", "minLength": 7 },
    "parents": {
      "type": "array",
      "items": { "type": "string" }
    },
    "agent_id": { "type": "string" },
    "hypothesis": { "type": ["string", "null"] },
    "metric_name": { "type": ["string", "null"] },
    "metric_value": { "type": ["number", "null"] },
    "status": {
      "type": "string",
      "enum": ["kept", "reverted", "failed", "pending", "evidence"]
    },
    "bundle_uri": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "board_post_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
